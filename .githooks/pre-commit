#!/usr/bin/env bash
# ==============================================================================
# SULCO — Pre-commit Hook & Local CI Validation Pipeline
# ==============================================================================
# Executado automaticamente antes de cada commit para garantir:
# 1. 🛡️  Proteção contra Vazamento de Segredos (.env, tokens, chaves)
# 2. 👤  Assinatura e Autoria Oficial do Commit
# 3. 🌿  Proteção da Branch Principal (main/master)
# 4. 🐍  Checagem de Sintaxe Python em arquivos modificados
# 5. 🧪  Execução da Suíte Rápida de Testes Unitários (pytest)
# 6. ⚛️   Compilação e Tipagem TypeScript do Frontend (Local CI Build)
# 7. 🐳  Verificação Estática de Especificação Docker
# ==============================================================================

set -eo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

echo -e "\n${BOLD}${CYAN}🔍 [SULCO Pre-Commit] Iniciando pipeline de validação local...${NC}"

# ------------------------------------------------------------------------------
# 1. 🛡️  PROTEÇÃO CONTRA VAZAMENTO DE SEGREDOS E CREDENCIAIS
# ------------------------------------------------------------------------------
echo -e "${BLUE}▶ [1/6] Auditando arquivos e segredos staged...${NC}"

STAGED_FILES=$(git diff --cached --name-only)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${YELLOW}⚠️  Nenhum arquivo staged para commit. Continuando...${NC}"
    exit 0
fi

# Bloqueio de arquivos proibidos (.env, .pat, chaves privadas)
PROHIBITED_PATTERNS='(\.env($|\.)|\.pat$|\.pem$|\.key$|id_rsa)'
BLOCKED_FILES=$(echo "$STAGED_FILES" | grep -E "$PROHIBITED_PATTERNS" || true)

if [ -n "$BLOCKED_FILES" ]; then
    echo -e "${RED}❌ ERRO CRÍTICO: Arquivo confidencial detectado no commit:${NC}"
    echo -e "${RED}$BLOCKED_FILES${NC}"
    echo -e "${YELLOW}👉 Remova o arquivo do staging com: git reset HEAD <arquivo>${NC}"
    exit 1
fi

# Varredura do diff staged em busca de chaves de API conhecidas
STAGED_DIFF=$(git diff --cached -U0)
SECRET_PATTERNS='(ghp_[A-Za-z0-9]{10,}|sk-[A-Za-z0-9]{20,}|Bearer [A-Za-z0-9_\-\.]{15,}|AKIA[0-9A-Z]{16})'

if echo "$STAGED_DIFF" | grep -E -q "$SECRET_PATTERNS"; then
    echo -e "${RED}❌ ERRO CRÍTICO: Padrão de chave de API ou token detectado no código staged!${NC}"
    echo -e "${YELLOW}👉 Remova o token ou credencial antes de commitar.${NC}"
    exit 1
fi

echo -e "${GREEN}  ✓ Nenhum arquivo sensível ou chave de API detectados.${NC}"

# ------------------------------------------------------------------------------
# 2. 👤  VALIDAÇÃO DE AUTORIA E ASSINATURA GIT
# ------------------------------------------------------------------------------
echo -e "${BLUE}▶ [2/6] Verificando assinatura do autor...${NC}"

AUTHOR_EMAIL=$(git config user.email || true)
AUTHOR_NAME=$(git config user.name || true)

if [ -z "$AUTHOR_EMAIL" ] || [ -z "$AUTHOR_NAME" ]; then
    echo -e "${RED}❌ ERRO: Nome ou e-mail git não configurados.${NC}"
    echo -e "${YELLOW}👉 Configure com:${NC}"
    echo -e "   git config user.name \"Antenor Pires\""
    echo -e "   git config user.email \"contato@antenorpires.eng.br\""
    exit 1
fi

if [[ "$AUTHOR_EMAIL" == *"@grupobrisanet.com.br"* ]]; then
    echo -e "${RED}❌ ERRO: O e-mail corporativo não deve ser usado neste repositório.${NC}"
    echo -e "${YELLOW}👉 Altere para o e-mail oficial:${NC}"
    echo -e "   git config user.email \"contato@antenorpires.eng.br\""
    exit 1
fi

echo -e "${GREEN}  ✓ Autor validado: ${AUTHOR_NAME} <${AUTHOR_EMAIL}>${NC}"

# ------------------------------------------------------------------------------
# 3. 🌿  PROTEÇÃO DA BRANCH PRINCIPAL
# ------------------------------------------------------------------------------
echo -e "${BLUE}▶ [3/6] Verificando branch ativa...${NC}"

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [ "$CURRENT_BRANCH" = "main" ] || [ "$CURRENT_BRANCH" = "master" ]; then
    echo -e "${RED}❌ ERRO DE GOVERNANÇA: Commits diretos na branch '${CURRENT_BRANCH}' estão bloqueados.${NC}"
    echo -e "${YELLOW}👉 Crie uma branch de trabalho antes de commitar:${NC}"
    echo -e "   git checkout -b feat/seu-recurso"
    echo -e "${CYAN}💡 (Se for estritamente necessário commitar na main, use: git commit --no-verify)${NC}"
    exit 1
fi

echo -e "${GREEN}  ✓ Branch de trabalho segura: '${CURRENT_BRANCH}'${NC}"

# ------------------------------------------------------------------------------
# 4. 🐍  COMPILAÇÃO DE SINTAXE PYTHON (Arquivos .py Staged)
# ------------------------------------------------------------------------------
echo -e "${BLUE}▶ [4/6] Verificando sintaxe de código Python...${NC}"

PYTHON_BIN="$ROOT_DIR/.venv/bin/python"
if [ ! -x "$PYTHON_BIN" ]; then
    PYTHON_BIN=$(command -v python3 || command -v python)
fi

STAGED_PY=$(echo "$STAGED_FILES" | grep -E '\.py$' || true)

if [ -n "$STAGED_PY" ]; then
    for py_file in $STAGED_PY; do
        if [ -f "$py_file" ]; then
            if ! "$PYTHON_BIN" -m py_compile "$py_file" 2>&1; then
                echo -e "${RED}❌ ERRO DE SINTAXE no arquivo: ${py_file}${NC}"
                exit 1
            fi
        fi
    done
    echo -e "${GREEN}  ✓ Sintaxe Python verificada sem erros nos arquivos staged.${NC}"
else
    echo -e "${GREEN}  ✓ Nenhum arquivo Python staged.${NC}"
fi

# ------------------------------------------------------------------------------
# 5. 🧪  SUÍTE RÁPIDA DE TESTES UNITÁRIOS (Pytest Local CI)
# ------------------------------------------------------------------------------
echo -e "${BLUE}▶ [5/6] Executando testes unitários rápidos de regressão...${NC}"

if [ -x "$PYTHON_BIN" ] && [ -d "tests" ]; then
    if ! "$PYTHON_BIN" -m pytest tests/test_consorcio.py tests/test_features.py -q --no-header -W error > /dev/null 2>&1; then
        echo -e "${RED}❌ FALHA NOS TESTES UNITÁRIOS: Regressão detectada em consórcio ou features.${NC}"
        echo -e "${YELLOW}👉 Execute para debugar: .venv/bin/python -m pytest tests/test_consorcio.py tests/test_features.py -vv${NC}"
        exit 1
    fi
    echo -e "${GREEN}  ✓ Testes unitários rápidos aprovados (45 testes).${NC}"
else
    echo -e "${YELLOW}  ⚠️  Ambiente virtual python não encontrado para testes. Pulando...${NC}"
fi

# ------------------------------------------------------------------------------
# 6. ⚛️  LOCAL CI BUILD (Frontend React & Docker)
# ------------------------------------------------------------------------------
echo -e "${BLUE}▶ [6/6] Checando builds locais de frontend e infraestrutura...${NC}"

# A. Se arquivos do frontend foram alterados, executa compilação do TypeScript + Vite
STAGED_FRONTEND=$(echo "$STAGED_FILES" | grep -E '^frontend/' || true)

if [ -n "$STAGED_FRONTEND" ]; then
    echo -e "   ${CYAN}📦 Arquivos de frontend staged detectados. Testando 'npm run build'...${NC}"
    if [ -d "frontend" ] && command -v npm &> /dev/null; then
        if ! (cd frontend && npm run build > /dev/null 2>&1); then
            echo -e "${RED}❌ ERRO DE BUILD NO FRONTEND: Falha na compilação do TypeScript ou Vite bundle.${NC}"
            echo -e "${YELLOW}👉 Teste localmente: cd frontend && npm run build${NC}"
            exit 1
        fi
        echo -e "${GREEN}   ✓ Frontend React compilado com sucesso (zero erros TypeScript).${NC}"
    fi
else
    echo -e "${GREEN}  ✓ Nenhum arquivo de frontend alterado.${NC}"
fi

# B. Se Dockerfile ou Compose foram alterados, testa definição do contêiner
STAGED_DOCKER=$(echo "$STAGED_FILES" | grep -E '(Dockerfile|docker-compose.*\.yml)$' || true)

if [ -n "$STAGED_DOCKER" ]; then
    if command -v docker &> /dev/null; then
        echo -e "   ${CYAN}🐳 Dockerfile alterado. Validando com BuildKit check...${NC}"
        if ! docker build --check . > /dev/null 2>&1; then
            echo -e "${RED}❌ ERRO NO DOCKERFILE: Definição de imagem Docker inválida.${NC}"
            exit 1
        fi
        echo -e "${GREEN}   ✓ Dockerfile validado pelo BuildKit.${NC}"
    fi
fi

# ------------------------------------------------------------------------------
# 🎉 SUCESSO TOTAL
# ------------------------------------------------------------------------------
echo -e "\n${BOLD}${GREEN}✅ [SULCO Pre-Commit] Todas as 6 etapas de validação passaram com sucesso!${NC}\n"
exit 0
