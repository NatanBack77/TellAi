# Modelo do arquivo .env (copie para .env e preencha). O .env NUNCA vai para o git nem para a imagem Docker.

# --- DeepSeek (camada LLM do chat com RAG) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=            # opcional; vazio = padrão de src/llm/provedores.py
SULCO_LLM_MODO=template    # template = sem LLM | offline = só lê o cache | online = chama a API

# --- Coleta de dados (NÃO usar em produção) ---
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Opcionais ---
# SULCO_RATE_LIMIT=1  SULCO_RATE_GERAL=120/60  SULCO_RATE_PESADO=20/60  SULCO_CONFIAR_PROXY=0
# SULCO_PREAQUECER=1

# --- Conversa por voz (teste no celular) ---
SULCO_VOZ_PIN=               # 4 a 8 dígitos; sem ele a voz fica desligada
SULCO_VOZ_MAX_SEG_DIA=900    # teto de segundos de áudio por dia
SULCO_VOZ_MAX_CHARS_DIA=4000 # teto de caracteres falados por dia
